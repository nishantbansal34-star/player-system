<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="4dp"/><solid android:color="#333D7BFF"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape><corners android:radius="4dp"/><gradient android:angle="0" android:startColor="#FF2C63FF" android:endColor="#FF9CD0FF"/></shape>
        </clip>
    </item>
</layer-list>
