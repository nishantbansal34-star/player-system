<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="4dp"/><solid android:color="#44222A55"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape><corners android:radius="4dp"/><gradient android:angle="0" android:startColor="#FF4169FF" android:centerColor="#FF8B5CFF" android:endColor="#FFC9B8FF"/></shape>
        </clip>
    </item>
</layer-list>
